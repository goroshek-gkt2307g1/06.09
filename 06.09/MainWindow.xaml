<Window x:Class="_06._09.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_06._09"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>

        <TextBox x:Name="t1" Text="{Binding ElementName=t2, Path=Text, Mode=TwoWay}"/>
        <TextBox x:Name="t2" Text="{Binding ElementName=t1, Path=Text, Mode=TwoWay}"/>

        <TextBox x:Name="input" Text="50" FontSize="{Binding ElementName=slider1, Path=Value}"/>
        <Slider Minimum="1" Maximum="200" x:Name="slider1" Value="{Binding ElementName=input, Path=Text}"/>
        
        <Slider x:Name="slider2" Value="{Binding ElementName=slider1, Path=Value}"/>

    </StackPanel>
</Window>
